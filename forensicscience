          <div class="opts" style="margin-top:8px"><div class="opt ${!D.longHair?'on':''}" onclick="setOpt('longHair',false)">짧은 머리</div><div class="opt ${D.longHair?'on':''}" onclick="setOpt('longHair',true)">긴 머리</div></div></div>
