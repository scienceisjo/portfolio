function renderNote(){
  const n=cluesCount();
  return `<div class="parch"><div class="eyebrow">CLUE NOTEBOOK</div><h2 class="tt">단서노트</h2>
    <div class="nbprog">수집한 과학 원리 ${n} / 4</div>
    <p class="lead" style="font-size:13.5px;text-align:center;color:#6a5230">실험을 완료할 때마다 단서와 과학 원리가 이곳에 정리됩니다.</p>
    <div class="nbgrid" style="margin-top:14px">${NOTE_ORDER.map(k=>{const e=NOTES[k];const open=CLUES[k];
      return `<div class="nbentry ${open?'unlocked':'locked'}" ${open?`onclick="this.classList.toggle('open')"`:''}>
        <div class="h"><span>${open?e.ic:'🔒'} ${open?e.title:'??? — 실험 미완료'}</span><span style="font-size:12px">${open?'▾':''}</span></div>
        ${open?`<div class="b" onclick="event.stopPropagation()"><div style="font-size:12px;color:#8a6a3a;font-family:Cinzel;letter-spacing:1px">${e.sub}</div><div class="clue-mini" style="margin-top:8px">🔎 단서: ${e.clue}</div>${e.body}</div>`:''}</div>`;
    }).join('')}</div></div>`;
}

/* ============ MODAL ============ */
function openDossier(){$('#modalGrid').innerHTML=SUSPECTS.map(s=>suspectCard(s)).join('');$('#modal').classList.add('open');}
function closeModal(){$('#modal').classList.remove('open');}
$('#modal').addEventListener('click',e=>{if(e.target.id==='modal')closeModal();});

/* ============ ROOT ============ */
function renderRoot(){
  if(APP.stage==='creator'){applyMood('dark');stage.innerHTML=renderCreator();updateMini();return;}
  if(APP.stage==='intro'){stage.innerHTML=renderIntro();updateMini();return;}
  applyMood(window.won?'bright':'dark');
  const map={story:renderStory,lab:renderLab,note:renderNote};
  stage.innerHTML=(map[APP.tab]||renderStory)(); syncTabs(); updateMini();
}
renderRoot();
</script>
