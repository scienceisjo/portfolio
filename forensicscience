<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CSI 과학수사대 — 로마의 사라진 보석</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Gowun+Batang:wght@400;700&family=Nanum+Brush+Script&family=Song+Myung&display=swap" rel="stylesheet">
<style>
:root{--ink:#2b2018;--ink-soft:#4a3a28;--parch:#ece0c4;--parch-d:#dccaa2;--bg:#120d08;--gold:#c9a44c;--gold-br:#e6c873;--crimson:#b53636;--crimson-d:#7e1f1f;--uv:#8b3df0;--glow:#37e2ff;--shadow:0 18px 40px rgba(0,0,0,.55);}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{font-family:'Gowun Batang',serif;color:var(--ink);min-height:100%;overflow-x:hidden;
  background:radial-gradient(1200px 700px at 18% -10%,#3a2a1b 0%,transparent 55%),radial-gradient(1000px 800px at 110% 120%,#2a1d12 0%,transparent 60%),linear-gradient(160deg,#160f09 0%,#241910 55%,#140d08 100%)}
body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:0;opacity:.5;background-image:repeating-linear-gradient(92deg,rgba(0,0,0,.06) 0 2px,transparent 2px 7px);mix-blend-mode:multiply}
.wrap{position:relative;z-index:1;max-width:940px;margin:0 auto;padding:0 16px 70px}
header{position:sticky;top:0;z-index:30;backdrop-filter:blur(3px);background:linear-gradient(180deg,rgba(18,12,7,.96),rgba(18,12,7,.8) 80%,transparent);padding:10px 16px 0;border-bottom:1px solid rgba(201,164,76,.22)}
.hbar{max-width:940px;margin:0 auto;display:flex;align-items:center;gap:12px;justify-content:space-between}
.brand{display:flex;align-items:center;gap:10px;min-width:0}
.seal{width:36px;height:36px;flex:0 0 36px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#d94c4c,#7e1f1f 70%);border:2px solid var(--gold);display:grid;place-items:center;color:#fff;font-family:'Cinzel';font-weight:900;font-size:11px;transform:rotate(-8deg);box-shadow:var(--shadow)}
.brand h1{font-family:'Cinzel';font-weight:700;color:var(--gold-br);font-size:14px;letter-spacing:1px;white-space:nowrap}
.brand h1 small{display:block;font-family:'Song Myung';color:#e8d9b8;font-weight:400;font-size:11px;letter-spacing:0}
.miniav{width:34px;height:42px;flex:0 0 34px;background:rgba(0,0,0,.2);border-radius:6px;border:1px solid rgba(201,164,76,.3);overflow:hidden;display:grid;place-items:center}
.miniav svg{width:100%;height:100%}
.tabs{max-width:940px;margin:8px auto 0;display:flex;gap:4px}
.tab{flex:1;font-family:'Song Myung';font-size:14px;text-align:center;padding:11px 6px;cursor:pointer;color:#bca878;background:rgba(255,255,255,.03);border:1px solid transparent;border-bottom:none;border-radius:9px 9px 0 0;transition:.15s;position:relative}
.tab .b{position:absolute;top:5px;right:8px;background:var(--crimson);color:#fff;font-size:10px;border-radius:9px;padding:0 6px;font-family:'Cinzel'}
.tab.on{color:#241704;background:linear-gradient(180deg,#e6c873,#c9a44c);border-color:#8a6e2f;font-weight:700}
.tab:hover:not(.on){color:#e8d9b8;background:rgba(255,255,255,.06)}
#stage{animation:fade .45s ease}
@keyframes fade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.parch{position:relative;border-radius:6px;color:var(--ink);padding:24px 22px;margin:18px 0;background:radial-gradient(120% 100% at 10% 0%,#f3e8cd 0%,var(--parch) 40%,var(--parch-d) 100%);box-shadow:var(--shadow),inset 0 0 0 1px rgba(120,90,40,.25)}
.parch::after{content:"";position:absolute;inset:9px;border:1.5px double #5a4427;border-radius:4px;pointer-events:none;opacity:.5}
.parch.tight{padding:18px}
.eyebrow{font-family:'Cinzel';letter-spacing:3px;font-size:11px;color:var(--crimson-d);font-weight:700}
h2.tt{font-family:'Song Myung';font-size:clamp(20px,4.2vw,28px);margin:6px 0 14px;line-height:1.25}
.lead{font-size:15.5px;line-height:1.85;color:var(--ink-soft)}
.lead b{color:var(--crimson-d)}
.brush{font-family:'Nanum Brush Script';font-size:25px;color:var(--crimson-d);line-height:1.5}
.center{text-align:center}
.thread{height:2px;background:linear-gradient(90deg,transparent,var(--crimson),transparent);margin:14px 0;opacity:.55}
.btn{font-family:'Song Myung';font-size:15.5px;cursor:pointer;border:none;border-radius:10px;padding:12px 20px;background:linear-gradient(180deg,#b53636,#8a2020);color:#fdeccb;box-shadow:0 5px 0 #5e1414,var(--shadow);transition:.12s;letter-spacing:.5px}
.btn:active{transform:translateY(3px);box-shadow:0 2px 0 #5e1414}
.btn.gold{background:linear-gradient(180deg,#e6c873,#c9a44c);color:#241704;box-shadow:0 5px 0 #8a6e2f}
.btn.gold:active{box-shadow:0 2px 0 #8a6e2f}
.btn.ghost{background:linear-gradient(180deg,#efe3c6,#dccaa2);color:#3a2c18;box-shadow:0 5px 0 #b29a64}
.btn.ghost:active{box-shadow:0 2px 0 #b29a64}
.btn:disabled{opacity:.4;cursor:not-allowed;transform:none;filter:grayscale(.4)}
.btnrow{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
.creator{display:grid;grid-template-columns:230px 1fr;gap:18px}
@media(max-width:640px){.creator{grid-template-columns:1fr}}
.preview{background:linear-gradient(180deg,#0e0a06,#241a11);border-radius:12px;border:1px solid rgba(201,164,76,.3);padding:18px;text-align:center;box-shadow:inset 0 0 50px rgba(0,0,0,.5)}
.preview .av{width:160px;height:230px;margin:auto}.preview .av svg{width:100%;height:100%}
.preview .nm{font-family:'Song Myung';color:var(--gold-br);font-size:18px;margin-top:8px}
.optblock{margin-bottom:14px}
.optblock .olab{font-family:'Song Myung';font-size:14px;color:#2a1d0f;margin:0 0 7px;display:flex;align-items:center;gap:6px}
.swatches{display:flex;gap:8px;flex-wrap:wrap}
.sw{width:30px;height:30px;border-radius:7px;cursor:pointer;border:2px solid rgba(0,0,0,.25);transition:.12s}
.sw:hover{transform:scale(1.1)}.sw.on{outline:3px solid var(--crimson);outline-offset:2px;transform:scale(1.1)}
.opts{display:flex;gap:7px;flex-wrap:wrap}
.opt{font-family:'Song Myung';font-size:13px;padding:8px 13px;border-radius:8px;cursor:pointer;background:rgba(255,255,255,.45);border:1.5px solid #b29a64;color:#3a2c18;transition:.12s}
.opt:hover{background:#fff}.opt.on{background:linear-gradient(180deg,#e6c873,#c9a44c);border-color:#8a6e2f;color:#241704;font-weight:700}
.nameinput{width:100%;font-family:'Song Myung';font-size:16px;padding:11px 13px;border-radius:8px;border:1.5px solid #b29a64;background:rgba(255,255,255,.6);color:#2a2012}
.nameinput:focus{outline:2px solid var(--gold);background:#fff}
.sgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-top:6px}
.scard{background:linear-gradient(160deg,#f1e6c9,#dccaa0);border:1.5px solid #6f5630;border-radius:10px;padding:14px;position:relative;transition:.15s}
.scard.pick{cursor:pointer}.scard.pick:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.scard.sel{outline:3px solid var(--crimson);outline-offset:2px}.scard.out{opacity:.45;filter:grayscale(.6)}
.scard .av{width:84px;height:118px;margin:0 auto 8px;background:rgba(0,0,0,.06);border-radius:8px}.scard .av svg{width:100%;height:100%}
.scard .nm{font-family:'Song Myung';font-size:16px;text-align:center;color:#2a2012}
.scard .role{font-size:12px;color:#6a5230;text-align:center;margin:3px 0 8px}
.scard .row{font-size:12px;line-height:1.55;color:#4a3a22}.scard .row b{color:#7e1f1f}
.scard .stamp{position:absolute;top:8px;right:8px;font-family:'Cinzel';font-size:9px;color:#fff;background:#7a7a7a;padding:2px 6px;border-radius:3px;transform:rotate(6deg);display:none}.scard.out .stamp{display:block}
.simgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px}
.simcard{background:linear-gradient(160deg,#f1e6c9,#dccaa0);border:1.5px solid #6f5630;border-radius:12px;padding:18px;cursor:pointer;transition:.15s;position:relative;text-align:center}
.simcard:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.simcard.locked{opacity:.5;cursor:not-allowed;filter:grayscale(.4)}
.simcard .ic{font-size:38px}.simcard h3{font-family:'Song Myung';font-size:17px;margin:6px 0 4px;color:#2a2012}.simcard p{font-size:12.5px;color:#6a5230;line-height:1.5}
.simcard .done{position:absolute;top:10px;right:10px;background:#2e7d4f;color:#fff;font-size:11px;padding:3px 9px;border-radius:9px;font-family:'Cinzel'}
.simcard .soon{position:absolute;top:10px;right:10px;background:#8a6e2f;color:#fff;font-size:10px;padding:3px 8px;border-radius:9px;font-family:'Cinzel'}
.lab{background:linear-gradient(180deg,#0e0a06,#1a1208);border-radius:12px;border:1px solid rgba(201,164,76,.25);padding:22px;margin-top:8px;box-shadow:inset 0 0 60px rgba(0,0,0,.6)}
.lab .hint{color:#cdb98e;font-size:14px;text-align:center;line-height:1.7;margin-bottom:14px}
.backbtn{font-family:'Song Myung';color:#cdb98e;background:none;border:1px solid rgba(201,164,76,.4);border-radius:8px;padding:7px 14px;cursor:pointer;font-size:13px}
.backbtn:hover{color:#fff;border-color:var(--gold)}
.subpanel{background:rgba(255,255,255,.05);border:1px solid rgba(201,164,76,.25);border-radius:12px;padding:16px;margin-top:18px}
/* candle */
.ctable{position:relative;height:300px;max-width:340px;margin:0 auto}
.cardEl{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);width:144px;height:38px;border-radius:4px;background:linear-gradient(#efe3c4,#d8c69c);border:1px solid #6f5630;display:grid;place-items:center;font-family:'Song Myung';font-size:13px;color:#5a4427;z-index:1;opacity:0;transition:.5s}
.cardEl.show{opacity:1;box-shadow:0 0 22px rgba(230,200,110,.6)}
.liftgrp{position:absolute;left:0;right:0;bottom:30px;height:230px;transition:transform 1.1s cubic-bezier(.4,0,.3,1);z-index:2}
.liftgrp.up{transform:translateY(-165px)}
.pdish{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:300px;height:46px;border-radius:50%;background:radial-gradient(ellipse at 50% 40%,#bfe3ef,#7fb8cf 75%,#5d97ad);box-shadow:0 10px 24px rgba(0,0,0,.5),inset 0 -6px 12px rgba(0,0,0,.25)}
.water-tint{position:absolute;bottom:0;width:300px;height:24px;border-radius:50%;background:radial-gradient(ellipse,rgba(214,80,80,.5),rgba(160,40,40,.25));opacity:0;transition:.6s}
.candle{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);width:18px;height:46px;border-radius:4px;background:linear-gradient(180deg,#f3e9cf,#d8c79a);z-index:2}
.flame{position:absolute;top:-22px;left:50%;transform:translateX(-50%);width:14px;height:22px;border-radius:50%/60% 60% 40% 40%;background:radial-gradient(circle at 50% 70%,#fff3a0,#ff9b2e 60%,#e0531a);opacity:0;animation:flick .25s infinite alternate;transition:opacity .3s}
.flame.lit{opacity:1}
@keyframes flick{from{transform:translateX(-50%) scale(1)}to{transform:translateX(-50%) scale(1.12,.92)}}
.cup{position:absolute;bottom:14px;left:50%;transform:translateX(-50%) translateY(-210px);width:92px;height:152px;border:3px solid rgba(200,225,235,.65);border-top:none;border-radius:0 0 14px 14px;background:linear-gradient(180deg,rgba(180,220,235,.1),rgba(150,200,220,.18));transition:.9s cubic-bezier(.5,0,.4,1);z-index:3}
.cup.down{transform:translateX(-50%) translateY(0)}
.cup .inwater{position:absolute;bottom:0;left:0;right:0;height:0;background:linear-gradient(180deg,rgba(200,70,70,.35),rgba(160,40,40,.55));transition:height 1s ease .6s;border-radius:0 0 11px 11px}
.stick{position:absolute;bottom:44px;left:50%;transform:translateX(-50%);background:#c9a44c;color:#241704;font-family:'Song Myung';font-size:12px;padding:3px 11px;border-radius:9px;opacity:0;transition:.3s;white-space:nowrap;z-index:4}
.stick.show{opacity:1}
.simcanvas{display:block;margin:0 auto;border-radius:12px;background:#06090d;max-width:100%}
.pbar{height:14px;border-radius:7px;background:rgba(255,255,255,.1);overflow:hidden;margin-top:4px}
.pbar>i{display:block;height:100%;transition:.35s}
/* luminol */
.darkbox{background:radial-gradient(circle at 50% 40%,#0a0d11,#020305);border:1px solid #1c2730;border-radius:12px;padding:24px;display:flex;gap:22px;justify-content:center;flex-wrap:wrap}
.spec{text-align:center}
.bshape{position:relative;width:110px;height:110px;display:grid;place-items:center;color:#5a3030;font-family:'Song Myung';font-size:13px;background:#1a0808;box-shadow:inset 0 0 18px #000;transition:.4s}
.bshape.circle{border-radius:50%}.bshape.square{border-radius:8px}
.bshape.glow{color:#dffaff;background:radial-gradient(circle,#0a3a44,#06181d);box-shadow:0 0 38px 8px rgba(55,226,255,.7),inset 0 0 28px rgba(55,226,255,.5);animation:lum 1.6s ease-in-out infinite}
@keyframes lum{50%{box-shadow:0 0 58px 14px rgba(55,226,255,.9),inset 0 0 38px rgba(55,226,255,.7)}}
.spec .cap{color:#b9a986;font-size:12.5px;margin-top:8px}
/* photo */
.uvstage{background:linear-gradient(180deg,#0d0a12,#08060c);border-radius:12px;padding:22px;transition:.5s;border:1px solid #221a30}
.uvstage.on{background:radial-gradient(circle at 50% 30%,#2a1850,#0e0818);box-shadow:inset 0 0 70px rgba(140,60,240,.4)}
.garments{display:flex;gap:24px;justify-content:center;flex-wrap:wrap}
.cloth{width:108px;height:138px;border-radius:10px 10px 14px 14px;margin:auto;transition:.5s;border:2px solid rgba(255,255,255,.15);clip-path:polygon(20% 0,80% 0,100% 18%,85% 26%,85% 100%,15% 100%,15% 26%,0 18%)}
.cloth.guard{background:linear-gradient(135deg,#c0392b,#2e86de 50%,#27ae60)}
.cloth.noble-dark{background:#f3efe8}
.cloth.noble-uv{background:linear-gradient(135deg,#e84393,#fdcb6e 50%,#6c5ce7)}
.gcap{color:#cbbfe0;font-size:12.5px;margin-top:10px;text-align:center}
/* clue/quiz/feedback */
.clue{position:relative;background:linear-gradient(135deg,#efe3c4,#dccaa0);border:2px solid #6f5630;border-radius:6px;padding:18px;text-align:center;box-shadow:var(--shadow);font-family:'Song Myung';color:#2a2012;line-height:1.9;font-size:16px;margin-top:16px}
.clue .corner{position:absolute;width:14px;height:14px;border:2px solid #6f5630}
.clue .c1{top:6px;left:6px;border-right:none;border-bottom:none}.clue .c2{top:6px;right:6px;border-left:none;border-bottom:none}
.clue .c3{bottom:6px;left:6px;border-right:none;border-top:none}.clue .c4{bottom:6px;right:6px;border-left:none;border-top:none}
.qcard{background:rgba(255,250,238,.95);border-radius:10px;padding:16px;margin-top:14px;color:#2a2012}
.qcard .q{font-family:'Song Myung';font-size:15px;margin-bottom:4px}
.choices{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
.choice{flex:1 1 130px;background:linear-gradient(180deg,#efe3c6,#dccaa2);border:1.5px solid #6f5630;border-radius:8px;padding:12px;font-family:'Song Myung';font-size:14px;color:#2a2012;cursor:pointer;text-align:center;transition:.12s}
.choice:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.choice.wrong{background:#e6b3ad;animation:shake .3s}.choice.right{background:#a8d8b0;outline:2px solid #2ea050}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.fb{margin-top:14px;padding:12px 14px;border-radius:8px;font-size:14px;line-height:1.7;display:none}
.fb.show{display:block;animation:fade .3s}
.fb.ok{background:rgba(46,160,80,.16);border:1px solid #2ea050;color:#1c5a30}
.fb.no{background:rgba(180,50,50,.16);border:1px solid #b53636;color:#7e1f1f}
.readout{display:flex;justify-content:space-around;gap:10px;margin:14px 0;flex-wrap:wrap}
.gauge{background:rgba(255,255,255,.05);border:1px solid rgba(201,164,76,.3);border-radius:10px;padding:10px 16px;text-align:center;min-width:120px}
.gauge .v{font-family:'Cinzel';font-size:22px;color:var(--glow)}.gauge .l{font-size:12px;color:#bca878}
.dialwrap{text-align:center;margin:4px 0}.dialwrap input[type=range]{width:88%;accent-color:var(--gold)}
/* speech bubble */
.speech{display:flex;align-items:center;gap:12px;margin-top:16px;background:rgba(255,250,238,.94);border-radius:12px;padding:12px 14px;border:1px solid #c9a44c}
.speech .sav{width:58px;height:80px;flex:0 0 58px;background:rgba(0,0,0,.06);border-radius:8px}.speech .sav svg{width:100%;height:100%}
.speech .bub{position:relative;background:#fff;border:2px solid #6f5630;border-radius:12px;padding:10px 14px;font-family:'Song Myung';color:#2a2012;font-size:14px;line-height:1.6}
.speech .bub::before{content:"";position:absolute;left:-9px;top:22px;border:7px solid transparent;border-right-color:#6f5630}
.speech .bub::after{content:"";position:absolute;left:-6px;top:22px;border:7px solid transparent;border-right-color:#fff}
/* notebook */
.nbgrid{display:grid;grid-template-columns:1fr;gap:14px}
.nbentry{border-radius:10px;overflow:hidden;border:1px solid rgba(90,68,39,.4)}
.nbentry .h{padding:14px 16px;font-family:'Song Myung';display:flex;justify-content:space-between;align-items:center;font-size:16px}
.nbentry.locked .h{background:linear-gradient(180deg,#2a2018,#1c1510);color:#7a6a4c}
.nbentry.unlocked .h{background:linear-gradient(180deg,#3a2a1a,#2a1d12);color:var(--gold-br);cursor:pointer}
.nbentry .b{background:rgba(255,250,238,.95);color:#2b2018;padding:0 16px;max-height:0;overflow:hidden;transition:.4s;font-size:14px;line-height:1.8}
.nbentry.open .b{padding:16px;max-height:700px}
.nbentry .clue-mini{background:#fff2c2;border:1px solid #d8b24a;border-radius:6px;padding:8px 12px;font-family:'Song Myung';color:#5a3a1f;margin-bottom:10px}
.nbentry .k{display:inline-block;background:#fff2c2;border:1px solid #d8b24a;border-radius:5px;padding:1px 7px;font-weight:700}
.nbentry ul{margin:6px 0 0 18px}.nbentry .arr{color:var(--crimson)}
.nbprog{text-align:center;color:#cdb98e;font-family:'Cinzel';letter-spacing:1px;margin-bottom:6px}
/* video */
.videobox{position:relative;width:100%;max-width:560px;margin:14px auto 0;border-radius:10px;overflow:hidden;border:1px solid rgba(201,164,76,.3);background:#000}
.videobox.portrait{max-width:300px}
.videobox .ar{position:relative;width:100%;padding-top:56.25%}
.videobox.portrait .ar{padding-top:177.78%}
.videobox iframe,.videobox video{position:absolute;inset:0;width:100%;height:100%;border:0}
.videoph{position:absolute;inset:0;display:grid;place-items:center;color:#bca878;font-size:14px;text-align:center;padding:24px;line-height:1.8;font-family:'Song Myung';background:repeating-linear-gradient(45deg,#161009 0 12px,#1c140b 12px 24px)}
/* bright -> dark mood */
#brightlayer{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:0;transition:opacity 1.4s ease;
  background:radial-gradient(1100px 640px at 50% -8%,#fdeccb 0%,#f2d488 30%,#e9b65c 50%,#9cc4e6 78%,#6fa8d4 100%)}
body.bright #brightlayer{opacity:1}
/* image slot */
.imgslot{position:relative;width:100%;border-radius:12px;overflow:hidden;border:1px solid rgba(201,164,76,.3);background:#0c0907}
.imgslot img{display:block;width:100%;height:100%;object-fit:cover}
.imgslot .ph{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:18px;color:#a8946a;font-family:'Song Myung';font-size:13px;line-height:1.7;background:repeating-linear-gradient(45deg,#15100a 0 12px,#1b140c 12px 24px)}
.imgslot .ph code{color:#e6c873;background:rgba(0,0,0,.4);padding:1px 6px;border-radius:4px;font-size:12px}
/* cutscene */
.cutscene{max-width:720px;margin:18px auto;animation:fade .4s ease}
.cut-stage{aspect-ratio:16/9;border-radius:14px 14px 0 0;overflow:hidden;border:1px solid rgba(201,164,76,.35);border-bottom:none;position:relative;background:#0c0907}
.cut-stage img{width:100%;height:100%;object-fit:cover}
.cut-stage .ph{position:absolute;inset:0;display:grid;place-items:center;text-align:center;color:#cdb98e;font-family:'Song Myung';padding:24px;font-size:14px;line-height:1.8}
.cut-stage.bright .ph{background:radial-gradient(circle at 50% 20%,#f6e3b4,#e7b25a 60%,#7fb0d8)}
.cut-stage.dark .ph{background:radial-gradient(circle at 50% 30%,#1c1626,#0a0710)}
.cut-stage .vignette{position:absolute;inset:0;box-shadow:inset 0 0 90px rgba(0,0,0,.55);pointer-events:none}
