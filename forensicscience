    <div id="polafter"></div>
  </div>`;
}
function startPolar(v){
  polState.ang=+v; const cv=document.getElementById('polcv'); if(!cv) return;
  const t=Math.cos(polState.ang*Math.PI/180)**2;
  const ga=document.getElementById('gAng'); if(ga)ga.textContent=polState.ang+'°';
  const gt=document.getElementById('gTr'); if(gt)gt.textContent=t>0.8?'많음 ☀️':t>0.3?'보통':'없음 🌑';
  const after=document.getElementById('polafter');
  if(after&&t>=0.9&&!after.dataset.shown){after.dataset.shown='1';after.innerHTML=polQuizHTML();}
  if(!polState.running){polState.running=true;polLoop(cv,cv.getContext('2d'));}
}
function rr(ctx,x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();}
function polLoop(cv,ctx){
  if(!cv.isConnected){polState.running=false;cancelAnimationFrame(polState.raf);return;}
  polState.t+=0.09; drawPol(ctx,polState.ang,polState.t);
  polState.raf=requestAnimationFrame(()=>polLoop(cv,ctx));
}
function drawPol(ctx,ang,phase){
  const W=480,H=240,my=120,A=24,k=0.16,f1=165,f2=315; ctx.clearRect(0,0,W,H);
  ctx.fillStyle='#06090d'; ctx.fillRect(0,0,W,H);
  ctx.fillStyle='#ffb43c'; ctx.beginPath(); ctx.arc(34,my,18,0,6.28); ctx.fill();
  ctx.strokeStyle='#ffce5c'; ctx.lineWidth=2; for(let i=0;i<8;i++){const a=i*Math.PI/4; ctx.beginPath(); ctx.moveTo(34+Math.cos(a)*22,my+Math.sin(a)*22); ctx.lineTo(34+Math.cos(a)*28,my+Math.sin(a)*28); ctx.stroke();}
  function wave(x0,x1,amp,color,alpha){ctx.strokeStyle=color;ctx.globalAlpha=alpha;ctx.lineWidth=2.4;ctx.beginPath();for(let x=x0;x<=x1;x+=2){const y=my+Math.sin((x-x0)*k+phase)*amp;if(x===x0)ctx.moveTo(x,y);else ctx.lineTo(x,y);}ctx.stroke();ctx.globalAlpha=1;}
  wave(60,f1-32,A*0.7,'#ffd86b',0.9); wave(60,f1-32,A*0.4,'#ffe9a0',0.5);   // unpolarized (여러 방향)
  wave(f1+32,f2-32,A,'#5fe0ff',0.95);                                       // polarized
  const ca=Math.abs(Math.cos(ang*Math.PI/180)),inten=ca*ca;
  wave(f2+32,396,A*ca,'#5fe0ff',Math.max(0.14,inten));                      // transmitted
  function filt(cx,rot,color){ctx.save();ctx.beginPath();ctx.arc(cx,my,40,0,6.28);ctx.fillStyle='rgba(255,255,255,.05)';ctx.fill();ctx.lineWidth=2;ctx.strokeStyle=color;ctx.stroke();
    ctx.beginPath();ctx.arc(cx,my,40,0,6.28);ctx.clip();ctx.translate(cx,my);ctx.rotate(rot*Math.PI/180);ctx.strokeStyle=color;ctx.lineWidth=2.2;
    for(let i=-4;i<=4;i++){ctx.beginPath();ctx.moveTo(i*9,-44);ctx.lineTo(i*9,44);ctx.stroke();}ctx.restore();}
  filt(f1,0,'#7fc7e6'); filt(f2,ang,'#e6c873');
  ctx.fillStyle='#0a0d12'; rr(ctx,404,58,64,124,6); ctx.fill();
  ctx.globalAlpha=inten; ctx.fillStyle='#e9dcc0'; rr(ctx,408,62,56,116,4); ctx.fill();
  ctx.fillStyle='#7e1f1f'; ctx.font="11px 'Song Myung',serif"; ctx.textAlign='center';
  ctx.fillText('날카로움',436,94); ctx.fillStyle='#2a2012'; ctx.fillText('→ 원형 혈흔',436,110);
  ctx.fillStyle='#7e1f1f'; ctx.fillText('뭉툭함',436,140); ctx.fillStyle='#2a2012'; ctx.fillText('→ 네모 혈흔',436,156);
  ctx.globalAlpha=1; ctx.fillStyle='#9ccbe0'; ctx.font="11px 'Song Myung',serif";
  ctx.fillText('편광판 1 (고정)',f1,202); ctx.fillStyle='#e6c873'; ctx.fillText('편광판 2 (회전)',f2,202);
}
