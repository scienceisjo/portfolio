let pSim={heat:true,parts:[],rise:0,raf:0};
function setHeat(h){pSim.heat=h;const pin=document.getElementById('pIn'),exp=document.getElementById('pexplain');
  if(pin){pin.style.width=(h?80:34)+'%';pin.style.background=h?'#ff8a5c':'#6fa8c8';}
  if(exp)exp.innerHTML=h?'불이 타는 동안 컵 속 공기가 뜨거워 입자가 <b style="color:#ff8a5c">빠르게</b> 움직여요. (압력 높음)':'불이 꺼지면 공기가 식어 입자가 <b style="color:#7fc7e6">느려지고</b> 컵 속 압력이 낮아져요 → 더 센 바깥 대기압이 물을 위로 밀어 올립니다.';
}
function startParticles(){
  const cv=document.getElementById('pcanvas'); if(!cv) return; const ctx=cv.getContext('2d');
  const W=cv.width,H=cv.height; const gas={x0:96,y0:24,x1:224}; const waterTop=150;
  if(pSim.parts.length===0){for(let i=0;i<14;i++)pSim.parts.push({x:gas.x0+Math.random()*(gas.x1-gas.x0),y:gas.y0+Math.random()*100,a:Math.random()*6.28});}
  pSim.heat=true; pSim.rise=0; cancelAnimationFrame(pSim.raf);
  function arrowUp(x,y0,y1){ctx.beginPath();ctx.moveTo(x,y0);ctx.lineTo(x,y1);ctx.moveTo(x-5,y1+7);ctx.lineTo(x,y1);ctx.lineTo(x+5,y1+7);ctx.stroke();}
  function loop(){
    if(!cv.isConnected){cancelAnimationFrame(pSim.raf);return;}
    const spd=pSim.heat?2.3:0.7; const target=pSim.heat?0:42; pSim.rise+=(target-pSim.rise)*0.05;
    ctx.clearRect(0,0,W,H); ctx.fillStyle='#06090d'; ctx.fillRect(0,0,W,H);
    ctx.fillStyle='rgba(60,140,200,.45)'; ctx.fillRect(0,waterTop,W,H-waterTop);
    ctx.fillStyle='rgba(80,170,230,.6)'; ctx.fillRect(gas.x0-6,waterTop-pSim.rise,(gas.x1-gas.x0)+12,pSim.rise+(H-waterTop));
    ctx.strokeStyle='rgba(200,225,235,.7)';ctx.lineWidth=3;
    ctx.beginPath();ctx.moveTo(gas.x0-8,waterTop+8);ctx.lineTo(gas.x0-8,gas.y0-6);ctx.lineTo(gas.x1+8,gas.y0-6);ctx.lineTo(gas.x1+8,waterTop+8);ctx.stroke();
    const gy1=waterTop-pSim.rise;
    pSim.parts.forEach(p=>{p.a+=(Math.random()-.5)*.3;p.x+=Math.cos(p.a)*spd;p.y+=Math.sin(p.a)*spd;
      if(p.x<gas.x0){p.x=gas.x0;p.a=Math.PI-p.a;}if(p.x>gas.x1){p.x=gas.x1;p.a=Math.PI-p.a;}
      if(p.y<gas.y0){p.y=gas.y0;p.a=-p.a;}if(p.y>gy1-4){p.y=gy1-4;p.a=-p.a;}
      ctx.beginPath();ctx.arc(p.x,p.y,4,0,6.28);ctx.fillStyle=pSim.heat?'#ff9b4a':'#7fc7e6';ctx.fill();});
    if(!pSim.heat){ctx.strokeStyle='rgba(127,199,230,.9)';ctx.lineWidth=2;[44,72,248,276].forEach(x=>arrowUp(x,182,162));}
    ctx.fillStyle='#8aa'; ctx.font="11px 'Song Myung',serif"; ctx.textAlign='center';
    ctx.fillText('컵 속 기체',(gas.x0+gas.x1)/2,gas.y0+10);
    pSim.raf=requestAnimationFrame(loop);
  }
  loop();
}

