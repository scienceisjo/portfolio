  victory:  null,  // 엔딩 — 보석을 되찾아 다시 밝아진 로마
};
function imgSlot(key,label,extraStyle){
  const v=IMAGES[key];
  if(v) return `<img src="${v}" alt="${label}">`;
  return `<div class="ph">🖼️ ${label}<br><span style="font-size:12px;opacity:.85">그림을 만들면 <code>IMAGES.${key}</code> 에 주소를 넣으세요</span></div>`;
}

/* ============ AVATAR (Minecraft style) ============ */
function mc(cfg){
  const c=Object.assign({skin:'#e8b690',hair:'#5a3a1f',hat:'none',glasses:'none',shirt:'#f4f1ea',pants:'#2c3e6b',accent:'#b53636',beard:false,longHair:false,eye:'#3a2a18'},cfg);
  let s='';
  if(c.longHair) s+=`<rect x="23" y="14" width="6" height="40" fill="${c.hair}"/><rect x="61" y="14" width="6" height="40" fill="${c.hair}"/>`;
  s+=`<rect x="29" y="8" width="32" height="32" fill="${c.skin}"/>`;
  if(c.hat!=='helmet'&&c.hat!=='hood') s+=`<rect x="29" y="8" width="32" height="8" fill="${c.hair}"/><rect x="29" y="8" width="4" height="14" fill="${c.hair}"/><rect x="57" y="8" width="4" height="14" fill="${c.hair}"/>`;
  s+=`<rect x="36" y="22" width="6" height="6" fill="#fff"/><rect x="48" y="22" width="6" height="6" fill="#fff"/>`;
  s+=`<rect x="38" y="24" width="3" height="4" fill="${c.eye}"/><rect x="50" y="24" width="3" height="4" fill="${c.eye}"/>`;
  s+=`<rect x="43" y="29" width="4" height="3" fill="${c.skin}" stroke="rgba(0,0,0,.12)" stroke-width="0.5"/><rect x="40" y="34" width="10" height="2" fill="#7a4a3a"/>`;
  if(c.beard) s+=`<rect x="33" y="31" width="24" height="9" fill="${c.hair}"/><rect x="40" y="34" width="10" height="2" fill="#5a3a2a"/>`;
  s+=`<rect x="29" y="42" width="32" height="36" fill="${c.shirt}"/><rect x="29" y="69" width="32" height="5" fill="${c.accent}"/>`;
  s+=`<rect x="17" y="42" width="11" height="26" fill="${c.shirt}"/><rect x="17" y="68" width="11" height="10" fill="${c.skin}"/>`;
  s+=`<rect x="62" y="42" width="11" height="26" fill="${c.shirt}"/><rect x="62" y="68" width="11" height="10" fill="${c.skin}"/>`;
  s+=`<rect x="30" y="78" width="14" height="40" fill="${c.pants}"/><rect x="46" y="78" width="14" height="40" fill="${c.pants}"/>`;
  s+=`<rect x="30" y="110" width="14" height="8" fill="#2a1d12"/><rect x="46" y="110" width="14" height="8" fill="#2a1d12"/>`;
  if(c.hat==='detective') s+=`<rect x="20" y="9" width="50" height="5" fill="#6b4f2a"/><rect x="28" y="0" width="34" height="11" fill="#7a5a30"/>`;
  if(c.hat==='laurel'){for(let i=0;i<5;i++){let x=24+i*9;s+=`<rect x="${x}" y="4" width="6" height="5" fill="#c9a44c" transform="rotate(${i*8-16} ${x+3} 6)"/>`;}}
  if(c.hat==='wizard') s+=`<polygon points="45,-10 24,12 66,12" fill="#3a2a6b"/><rect x="22" y="11" width="46" height="5" fill="#2a1d52"/>`;
  if(c.hat==='helmet') s+=`<rect x="27" y="2" width="36" height="16" fill="#8a8f99"/><rect x="43" y="2" width="4" height="20" fill="#6a6f79"/><rect x="40" y="-6" width="10" height="8" fill="${c.accent}"/>`;
  if(c.hat==='hood') s+=`<rect x="25" y="4" width="40" height="14" fill="${c.shirt}"/><rect x="25" y="4" width="6" height="36" fill="${c.shirt}"/><rect x="59" y="4" width="6" height="36" fill="${c.shirt}"/>`;
  if(c.glasses==='round') s+=`<circle cx="39" cy="25" r="6" fill="none" stroke="#222" stroke-width="2"/><circle cx="51" cy="25" r="6" fill="none" stroke="#222" stroke-width="2"/><rect x="44" y="24" width="3" height="2" fill="#222"/>`;
  if(c.glasses==='goggles') s+=`<rect x="33" y="20" width="11" height="9" rx="3" fill="rgba(120,200,220,.4)" stroke="#333" stroke-width="2"/><rect x="46" y="20" width="11" height="9" rx="3" fill="rgba(120,200,220,.4)" stroke="#333" stroke-width="2"/>`;
  return `<svg viewBox="0 0 90 122" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg">${s}</svg>`;
}

